{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/petpack-v1.json",
  "title": "Desktop Pet Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "name", "defaultSize", "icon", "actions"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "defaultSize": { "type": "integer", "minimum": 72, "maximum": 320 },
    "icon": { "type": "string", "const": "icon.png" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "loop", "frames"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 24 },
          "role": { "enum": ["idle", "click", "drag", "sleep", "custom"] },
          "loop": { "type": "boolean" },
          "frames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 120,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "duration"],
              "properties": {
                "file": { "type": "string", "pattern": "^assets/" },
                "duration": { "type": "integer", "minimum": 20, "maximum": 2000 }
              }
            }
          }
        }
      }
    }
  }
}
